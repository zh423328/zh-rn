# 复制为 .env（或 .env.development / .env.production）后修改
#
# 重要：只有 EXPO_PUBLIC_ 前缀的变量会暴露给客户端代码，
# 因此这里只能放公开配置，绝不能放服务端密钥/签名密码。

# 后端接口地址
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# 实时消息地址（WebSocket）；留空则跳过实时连接
EXPO_PUBLIC_REALTIME_URL=wss://api.example.com/ws

# OTA 更新服务地址（自托管时指向你自己的服务器）
# 注意：这个值需要同时写进 app.json 的 updates.url（构建期常量，不是运行时读取）
# 这里仅作记录与 CI 替换用，运行时请以 app.json 为准。
EXPO_PUBLIC_UPDATES_URL=https://updates.example.com/manifest
